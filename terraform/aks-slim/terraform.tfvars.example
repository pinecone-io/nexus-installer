# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# subscription_id is read from ARM_SUBSCRIPTION_ID if left unset.

# subscription_id = "00000000-0000-0000-0000-000000000000"
location = "westus3"

# Naming: resources are <type>-<name_prefix>-<environment>, e.g. rg-nexus-slim-dev.
# Change environment to stand up another instance (staging/prod) from the same module.
name_prefix = "nexus-slim"
environment = "dev"

# Pinned to the customer's target minor; AKS selects the patch.
kubernetes_version = "1.35"

node_count   = 2
node_vm_size = "Standard_D8s_v5"

# Overlay lets a /27 node subnet suffice.
aks_subnet_prefix = "10.224.0.0/27"

# Storage + workload identity (set enable_storage_identity = false to bring your own).
enable_storage_identity = true
# Stem the seven Nexus data-path containers derive from: <stem>-db plus six <stem>-nexus-*
# (source, knowledge, archive, traces, snapshots, library). Supply only the stem; it also
# feeds the chart's blob.abs.container. Null -> <name_prefix>-<environment>.
blob_container_prefix = "acme"

# Workload-identity federation is automatic — the module federates every blob-accessing SA
# the chart runs. Set nothing for a standard install.
#
# helm_release_name = "nexus"   # release name you `helm install` with
# helm_namespace    = "nexus"   # namespace the chart installs into
#
# Extra (non-standard) SAs only, appended to the derived set:
# workload_federated_credentials = [
#   { name = "my-extra-sa", namespace = "nexus", service_account = "my-extra-sa" },
# ]
